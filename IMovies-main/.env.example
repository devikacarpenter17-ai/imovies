# Used by docker-compose.yml. start-docker.bat creates a copy of this file called .env for you.
JWT_SECRET=change_this_to_a_long_random_string

# Free key from https://www.themoviedb.org/settings/api for real movies and posters
TMDB_API_KEY=

# Optional: use MongoDB Atlas instead of the bundled database
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/imovies?retryWrites=true&w=majority
