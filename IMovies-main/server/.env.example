PORT=5000
# Free key from https://www.themoviedb.org/settings/api  -> real movies, posters and trailers
TMDB_API_KEY=
# Local MongoDB (default). For MongoDB Atlas, replace the line below with your connection string, e.g.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/imovies?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/imovies
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Minutes a seat stays held while the user checks out
SEAT_HOLD_MINUTES=5
